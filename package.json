{
  "name": "minesweeper-js",
  "displayName": "Minesweeper",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "Classic Minesweeper for the browser, made for phones first. Plain static files with no build step, and an optional global board checked by the server.",
  "scripts": {
    "test": "node --test test/*.test.mjs && npm --prefix server test --silent",
    "e2e": "node test/e2e.mjs",
    "e2e:live": "node test/e2e-live.mjs",
    "e2e:pwa": "node test/e2e-pwa.mjs",
    "deploy:api": "server/deploy/deploy.sh",
    "serve": "python3 -m http.server 8080",
    "icons": "node scripts/icons.mjs",
    "sw:version": "node scripts/sw-version.mjs",
    "version": "node scripts/app-version.mjs && node scripts/sw-version.mjs"
  }
}
